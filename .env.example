# Salin file ini ke .env.local lalu isi dengan nilai dari
# Supabase Dashboard > Project Settings > API.
#
# Kedua nilai di bawah aman dibaca browser: publishable/anon key hanya bisa
# menembus baris yang diizinkan row level security. JANGAN pernah menaruh
# service_role key di sini atau di variabel apa pun berawalan NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
