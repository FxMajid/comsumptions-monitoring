# Salin file ini ke .env.local lalu isi dengan nilai dari
# Supabase Dashboard > Project Settings > API.
#
# Kedua nilai di bawah aman dibaca browser: publishable/anon key hanya bisa
# menembus baris yang diizinkan row level security. JANGAN pernah menaruh
# service_role key di sini atau di variabel apa pun berawalan NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Origin absolut yang dicetak ke dalam QR klaim peserta, tanpa slash di akhir.
# Wajib diisi sebelum QR dicetak: lembar yang sudah dicetak berumur lebih panjang
# daripada URL deployment tempat ia dibuat. Bila kosong, aplikasi memakai
# VERCEL_PROJECT_PRODUCTION_URL, lalu header request sebagai jalan terakhir.
APP_URL=https://konsumsi.contoh.id
